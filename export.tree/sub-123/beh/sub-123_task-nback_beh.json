{
  "trial": {
    "Description": "1-based trial index"
  },
  "stim": {
    "Description": "Stimulus text/item (uppercase)"
  },
  "response": {
    "Description": "Binary response derived from resp.rt: 1=rt present, 0=rt missing",
    "Levels": [
      {
        "value": 0,
        "label": "no"
      },
      {
        "value": 1,
        "label": "yes"
      }
    ]
  },
  "target": {
    "Description": "1=target (corrAns specified), 0=non-target (corrAns None/empty)",
    "Levels": [
      {
        "value": 0,
        "label": "non-target"
      },
      {
        "value": 1,
        "label": "target"
      }
    ]
  },
  "correctness": {
    "Description": "Correct(1)/Incorrect(0) computed from response vs target",
    "Levels": [
      {
        "value": 0,
        "label": "incorrect"
      },
      {
        "value": 1,
        "label": "correct"
      }
    ]
  },
  "rt": {
    "Description": "Reaction time copied from CSV column resp.rt (NaN if no response)",
    "Units": "task-defined"
  }
}